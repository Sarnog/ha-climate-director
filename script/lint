#!/usr/bin/env bash
# Precies wat de CI aan lint draait, lokaal.
# Exactly what CI runs for linting, locally.
set -e
cd "$(dirname "$0")/.."

if [ -x ".venv/Scripts/python.exe" ]; then
  PYTHON=".venv/Scripts/python.exe"
else
  PYTHON=".venv/bin/python"
fi

"$PYTHON" -m ruff check .
"$PYTHON" -m ruff format --check .
